{
  "name": "send-check-for-gmail",
  "version": "1.1.1",
  "private": true,
  "description": "Chrome extension that checks recipients, body and attachments before sending in Gmail to prevent mis-sends.",
  "license": "MIT",
  "author": "Tatsuki Gunji",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "fixtures:anonymize": "node scripts/anonymize-fixture.mjs",
    "fixtures:save": "node scripts/anonymize-fixture.mjs --save",
    "fixtures:check": "node scripts/anonymize-fixture.mjs --check",
    "package": "npm run build && node scripts/package.mjs"
  },
  "devDependencies": {
    "@types/chrome": "^0.1.43",
    "esbuild": "^0.28.2",
    "eslint": "^10.6.0",
    "jsdom": "^30.1.2",
    "prettier": "^3.8.1",
    "typescript": "~6.0.0",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.0.4"
  }
}
